# ---------- Database ----------
# Vercel/Neon Postgres 연결 문자열. Vercel 프로젝트 대시보드에서 발급.
DATABASE_URL="postgresql://user:pass@HOST.neon.tech/dbname?sslmode=require"

# ---------- Email (Resend) ----------
RESEND_API_KEY="re_xxx"
# 발신 주소(검증된 도메인). 예: alerts@saehan.co.kr
ALERT_EMAIL_FROM="alerts@example.com"
# 발신자 표시명
ALERT_EMAIL_FROM_NAME="새한프라텍 EMS"

# ---------- Public ----------
# 알림 이메일 내 상세 링크 베이스. 배포 후 Vercel 도메인으로 교체.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Cron auth ----------
# Vercel Cron 호출 시 Authorization 헤더로 검증.
CRON_SECRET="replace-with-long-random-string"
